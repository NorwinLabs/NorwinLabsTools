<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Brand palette.

      Both schemes are declared here rather than splitting the dark one into values-night: a
      resource that exists only under a qualifier can still be queried in a configuration that
      does not match it, which is lint's MissingDefaultResource and a real crash risk.
      values-night/themes.xml simply selects the dark roles.

      Until now the app defined no colours at all, so it fell back to Material's baseline purple -
      which is not a brand, it is the absence of one. Teal reads as tooling rather than
      consumer-social, and holds up against the saturated per-tool card colours in ToolRegistry
      without competing with them.
    -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Light -->
    <color name="md_theme_light_primary">#FF006A6A</color>
    <color name="md_theme_light_onPrimary">#FFFFFFFF</color>
    <color name="md_theme_light_primaryContainer">#FF6FF7F6</color>
    <color name="md_theme_light_onPrimaryContainer">#FF002020</color>
    <color name="md_theme_light_secondary">#FF4A6363</color>
    <color name="md_theme_light_onSecondary">#FFFFFFFF</color>
    <color name="md_theme_light_secondaryContainer">#FFCCE8E7</color>
