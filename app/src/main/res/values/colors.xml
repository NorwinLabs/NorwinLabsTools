    <!--
      Dark. Not the light scheme inverted: primary lightens so it stays legible on dark surfaces,
      containers darken so text on them keeps contrast, and surfaces are near-neutral with a
      slight teal cast rather than pure black - which stops the saturated tool-card colours
      vibrating against the background on OLED screens.
    -->
    <color name="md_theme_dark_primary">#FF4CDADA</color>
