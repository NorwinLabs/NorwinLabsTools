<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      App-wide component defaults. Both theme files point at these, so restyling a component for
      every screen is a change here rather than a hunt through twenty layouts.
    -->

    <!-- Flat tonal surface instead of a drop shadow: reads as modern and stays calm in dark mode. -->
    <style name="Widget.Norwin.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Norwin.Medium</item>
    </style>

    <style name="Widget.Norwin.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Home -->
    <style name="TextAppearance.Norwin.Greeting" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Norwin.Date" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Norwin.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Norwin.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
