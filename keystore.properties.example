# Copy to keystore.properties (gitignored) to sign release builds locally.
#
# storeFile is resolved relative to the repository root. Keep the keystore itself
# OUTSIDE the repository if you can - anywhere inside it is one bad `git add -f`
# away from being published.
#
# On CI these same values come from repository secrets, as the environment
# variables named in brackets.

storeFile=../norwin-release.jks        # [KEYSTORE_FILE]
storePassword=CHANGE_ME                # [KEYSTORE_PASSWORD]
keyAlias=norwin-release                # [KEY_ALIAS]
keyPassword=CHANGE_ME                  # [KEY_PASSWORD]
