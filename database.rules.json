{
  "rules": {
    "//": [
      "Stage 1 of hardening: require an authenticated identity and bound the shape and size of",
      "everything written. This is what stops the database being read or written by anyone who",
      "simply has the project URL.",
      "",
      "It does NOT yet prove that a given writer owns a given member or inbox node - any signed-in",
      "client can still write to another member's entry. That needs uid ownership claims in the",
      "data model; see FIREBASE_SECURITY.md. Deploy this first, because it closes public access,",
      "then tighten.",
      "",
      "Deploy any change here with an emulator run first:",
      "  firebase emulators:start --only database",
      "  firebase deploy --only database"
    ],

    ".read": false,
    ".write": false,

    "circles": {
      "$circleId": {
        ".read": "auth != null",
        ".validate": "$circleId.length <= 32",

        "admin": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 64"
        },

        "members": {
          "$memberId": {
            ".write": "auth != null",
            ".validate": "$memberId.length <= 64",

            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "photo": { ".validate": "newData.isString() && newData.val().length <= 300000" },
            "lastUpdated": { ".validate": "newData.isNumber()" }
          }
        }
      }
    },

    "voipInbox": {
      "$userId": {
        ".read": "auth != null",
        ".validate": "$userId.length <= 64",

        "activeCallId": {
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 128"
        }
      }
    },

    "voipCalls": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$callId.length <= 128",

        "callerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "callerName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "calleeId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "offer": { ".validate": "newData.isString() && newData.val().length <= 30000" },
        "answer": { ".validate": "newData.isString() && newData.val().length <= 30000" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt": { ".validate": "newData.isNumber()" },

        "candidates": {
          "$role": {
            "$candidateId": { ".validate": "newData.isString() && newData.val().length <= 8000" }
          }
        }
      }
    }
  }
}
